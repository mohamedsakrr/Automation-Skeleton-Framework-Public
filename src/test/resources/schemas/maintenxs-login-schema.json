{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": [
    "accessToken",
    "tokenType",
    "expiresIn"
  ],
  "properties": {
    "accessToken": {
      "type": "string",
      "minLength": 1
    },
    "tokenType": {
      "type": "string",
      "enum": [
        "Bearer"
      ]
    },
    "expiresIn": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": true
}
